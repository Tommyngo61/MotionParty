{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "controller (serve)",
      "detail": "Needs the dev database. Run the 'dev: bring up the control plane' task first, or at least Postgres and Redis.",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/console/cmd/controller",
      "cwd": "${workspaceFolder}/console",
      "env": {
        "METERNODE_ENV": "dev",
        "METERNODE_HTTP_ADDR": ":8080",
        "METERNODE_PUBLIC_URL": "http://localhost:8080",
        "METERNODE_DATABASE_URL": "postgres://meternode:meternode@localhost:5432/meternode?sslmode=disable",
        "METERNODE_REDIS_URL": "redis://localhost:6379/0",
        "METERNODE_LOG_FORMAT": "text",
        "METERNODE_LOG_LEVEL": "debug",
        "METERNODE_BOOTSTRAP_ADMIN_TOKEN": "dev-admin-token"
      }
    },
    {
      "name": "controller: migrate",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/console/cmd/controller",
      "args": ["migrate"],
      "env": {
        "METERNODE_DATABASE_URL": "postgres://meternode:meternode@localhost:5432/meternode?sslmode=disable"
      }
    },
    {
      "name": "simulator (25 nodes)",
      "detail": "Enrols simulated nodes against a running controller and verifies every credential it is handed.",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/console/cmd/simulator",
      "args": [
        "-controller", "http://localhost:8080",
        "-admin-token", "dev-admin-token",
        "-n", "25"
      ]
    },
    {
      "name": "simulator (bad network)",
      "detail": "200 nodes, 300ms latency, 5% link failure — the conditions most failure modes only appear under.",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/console/cmd/simulator",
      "args": [
        "-controller", "http://localhost:8080",
        "-admin-token", "dev-admin-token",
        "-n", "200", "-concurrency", "64",
        "-latency", "300ms", "-jitter", "100ms", "-fail-pct", "5"
      ]
    },
    {
      "name": "agent",
      "detail": "Runs against agent/dev/agent.yaml — no root, no /etc, no /var/lib.",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/agent/cmd/agent",
      "cwd": "${workspaceFolder}/agent",
      "args": ["-config", "dev/agent.yaml"],
      "preLaunchTask": "agent: write the scratch config"
    },
    {
      "name": "meternodectl status",
      "detail": "Talks to a locally-running agent over its unix socket.",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/agent/cmd/agentctl",
      "cwd": "${workspaceFolder}/agent",
      "args": ["-socket", "${workspaceFolder}/agent/dev/run/agent.sock", "status"]
    }
  ]
}
