# MeterNode Agent
#
# The hardening below is not decoration. This process runs on a machine in a
# private residence, on a LAN shared with the homeowner's laptop, phone, and TV.
# Every directive here narrows what a compromised agent could reach, and each
# one is justified in SECURITY.md.

[Unit]
Description=MeterNode Agent
Documentation=https://github.com/meterhome/meternode-agent
After=network-online.target
Wants=network-online.target
# The agent supervises workload containers (M5) but must still run, sample, and
# answer meternodectl when Docker is down — a broken Docker is one of the things
# an operator needs telemetry about.
After=docker.service
Wants=docker.service

[Service]
Type=notify
NotifyAccess=main

# Not root. The agent needs the Docker socket (via the docker group) and
# read access to sysfs and /proc; nothing it does needs UID 0.
User=nodeagent
Group=nodeagent
SupplementaryGroups=docker

ExecStart=/usr/bin/meternode-agent -config /etc/meternode/agent.yaml
ExecReload=/bin/kill -HUP $MAINPID

# Disconnection is normal operation on a residential link, and so is a
# homeowner power-cycling the machine. Restart=always with a backoff, and a
# StartLimit generous enough that a transient fault does not leave the unit
# dead — a node in "failed" state needs a site visit.
Restart=always
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=10

# The agent pings this from its sampling loop and STOPS pinging when sampling
# stalls. That catches the failure a liveness check cannot: a process that is
# running, answering its socket, and doing nothing.
WatchdogSec=90s

# Give a shutdown time to flush and record a clean exit, so the next start does
# not count it as a crash.
TimeoutStopSec=30s
KillSignal=SIGTERM

# --- Filesystem -----------------------------------------------------------
StateDirectory=meternode
StateDirectoryMode=0750
RuntimeDirectory=meternode
RuntimeDirectoryMode=0755
ConfigurationDirectory=meternode
ConfigurationDirectoryMode=0750

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/meternode /run/meternode

# --- Privilege ------------------------------------------------------------
# The agent holds NO capabilities. Everything it reads — DMI in sysfs, /proc,
# NVML, the Docker socket — is reachable without them on the image we ship.
# The one thing this costs is SMART, which needs a privileged ioctl: the agent
# reports smart_ok as NULL ("could not read") rather than taking CAP_SYS_RAWIO
# for it. See SECURITY.md.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=default
ProcSubset=all
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount

# The agent makes outbound TCP/443 connections and listens on ONE unix socket.
# AF_NETLINK is needed to enumerate interfaces for the fingerprint.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# --- Resources ------------------------------------------------------------
# The GPU belongs to the workload, not to us. These are ceilings that make a
# runaway agent a restarted agent rather than a node that needs a site visit.
MemoryMax=512M
MemoryHigh=384M
CPUQuota=25%
TasksMax=256

[Install]
WantedBy=multi-user.target
